# Security: Prevent execution of any scripts in the uploads directory
<FilesMatch "(?i)\.(php|php3|php4|php5|php7|php8|phtml|phar|pl|py|cgi|asp|aspx|sh|bash|exe|svg|shtml)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Disable PHP engine in upload directory
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

# Prevent script execution handlers
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .cgi .pl .py
Options -ExecCGI -Indexes
